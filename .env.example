# API Keys — fill in your own
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Provider selection: "gemini" or "openai" (vision + refiner; shown in UI)
IMAGE_GEN_PROVIDER=gemini
LLM_PROVIDER=gemini

# Prompt enhancement only — env-only, not in UI. Groq has no vision API.
PROMPT_ENHANCEMENT_PROVIDER=groq
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Gemini image model (when IMAGE_GEN_PROVIDER=gemini)
# Options: nano-banana-pro-preview | gemini-3-pro-image-preview | gemini-2.5-flash-image | gemini-2.0-flash-exp-image-generation
GEMINI_IMAGE_MODEL=nano-banana-pro-preview

# Vision Label Placer — accuracy vs cost trade-off
# Ensemble rounds: run N detection calls, take median (1 = no ensemble, 3 = default)
VISION_ENSEMBLE_ROUNDS=3
# Verification rounds: max verify-correct iterations (0 = skip verification, 2 = default)
VISION_VERIFY_ROUNDS=2
